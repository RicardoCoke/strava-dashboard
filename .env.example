# Backend server (bind to localhost unless you add authentication)
HOST=127.0.0.1
PORT=8080

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:4200/auth/strava/callback

# Local storage
DB_PATH=./data/dashboard.db

# Random 32+ byte secret for signing session cookies, as hex (64+ characters).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Marathon build calendar (feature 004). Path to your training-plan CSV (keep it out of git).
TRAINING_PLAN_CSV=
# Optional: first Monday of the build, as YYYY-MM-DD. Leave empty for the default (2026-08-17).
TRAINING_PLAN_START_DATE=

# Lactate-threshold heart rate in bpm (whole number, 100-220). Used by the training load chart. Restart the backend after changing it.
LTHR_BPM=

# Maximum heart rate in bpm (whole number, 120-230). Used by the VO2max estimate. Leave empty for the estimate of 194. Restart the backend after changing it.
MAX_HR_BPM=
