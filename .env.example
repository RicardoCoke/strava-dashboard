# Backend server (bind to localhost unless you add authentication)
HOST=127.0.0.1
PORT=8080

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:4200/auth/strava/callback

# Local storage
DB_PATH=./data/dashboard.db

# Random 32+ byte secret for signing session cookies
SESSION_SECRET=
